---
import type { CollectionEntry } from 'astro:content';
import { CATEGORIES, fmtDate, readingTime } from '../lib/site';
const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const c = CATEGORIES[post.data.category];
---
<article class="card">
  <div class="meta">
    <a class="badge" href={`/category/${post.data.category}/`}>{c.icon} {c.name}</a>
    <time datetime={post.data.date.toISOString()}>{fmtDate(post.data.date)}</time>
    <span>{readingTime(post.body ?? '')} min read</span>
  </div>
  <h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
  <p>{post.data.description}</p>
  <div class="tags">{post.data.tags.map((t) => <a class="tag" href={`/tag/${t}/`}>{t}</a>)}</div>
</article>
