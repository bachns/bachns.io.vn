---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { CATEGORIES, SITE, getPosts } from '../lib/site';
const posts = await getPosts();
const count = (k: string) => posts.filter((p) => p.data.category === k).length;
---
<Base>
  <section class="hero container">
    <div class="hero-grid">
      <div class="hero-text">
        <p class="hero-eyebrow" data-type>Hi, my name is</p>
        <h1 class="hero-name" data-type>{SITE.name}</h1>
        <p class="hero-alt" data-type>{SITE.altName}</p>
        <p class="hero-role" data-type>{SITE.position}</p>
        <p class="hero-bio" data-type>{SITE.bio}</p>
        <div class="hero-cta">
          <a class="btn" href="/blog/">Read the blog</a>
          <a class="btn ghost" href="/about/">About me</a>
          <a class="btn ghost" href={SITE.github}>GitHub</a>
        </div>
      </div>
      <div class="hero-photo">
        <div class="avatar"><img src={SITE.avatar} alt={`${SITE.name} — profile photo`} width="768" height="768" fetchpriority="high" /></div>
      </div>
    </div>
  </section>

  <div class="container">
    <div class="section-title">// categories</div>
    <div class="cats">
      {Object.entries(CATEGORIES).map(([k, c]) => (
        <a class="cat" href={`/category/${k}/`}><span class="ic">{c.icon}</span><strong>{c.name}</strong><small>{count(k)} {count(k) === 1 ? 'post' : 'posts'}</small></a>
      ))}
    </div>

    <div class="section-title">// latest posts</div>
    <div class="posts">{posts.slice(0, 8).map((p) => <PostCard post={p} />)}</div>
    <p style="margin-top:24px"><a href="/blog/">→ View all posts</a></p>
  </div>
  <script is:inline>
    (() => {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const els = [...document.querySelectorAll('[data-type]')];
      const full = els.map((e) => e.textContent.trim());
      els.forEach((e) => (e.textContent = ''));
      const caret = document.createElement('span'); caret.className = 'caret'; caret.textContent = '▍';
      const SPEED = 110;
      let i = 0;
      const next = () => {
        if (i >= els.length) return;
        const el = els[i], words = full[i].split(' '); let n = 0;
        el.appendChild(caret);
        const tick = () => {
          if (n < words.length) {
            caret.insertAdjacentText('beforebegin', (n ? ' ' : '') + words[n++]);
            setTimeout(tick, SPEED);
          } else { i++; if (i >= els.length) caret.remove(); next(); }
        };
        tick();
      };
      next();
    })();
  </script>
</Base>
