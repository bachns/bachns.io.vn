---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/site';
export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { posts: posts.filter((p) => p.data.tags.includes(tag)) } }));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---
<Base title={`#${tag}`}>
  <div class="container narrow">
    <div class="page-title"><h1>#{tag}</h1><p>{posts.length} posts</p></div>
    <div class="posts" style="margin-top:24px">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</Base>
