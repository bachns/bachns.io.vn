---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, getPosts } from '../../lib/site';
export function getStaticPaths() { return Object.keys(CATEGORIES).map((cat) => ({ params: { cat } })); }
const { cat } = Astro.params as { cat: keyof typeof CATEGORIES };
const c = CATEGORIES[cat];
const posts = (await getPosts()).filter((p) => p.data.category === cat);
---
<Base title={c.name} description={c.desc}>
  <div class="container narrow">
    <div class="page-title"><h1>{c.icon} {c.name}</h1><p>{c.desc}</p></div>
    <div class="posts" style="margin-top:24px">
      {posts.length ? posts.map((p) => <PostCard post={p} />) : <p>No posts yet.</p>}
    </div>
  </div>
</Base>
