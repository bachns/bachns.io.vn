---
import Base from '../../layouts/Base.astro';
import { CATEGORIES, getPosts } from '../../lib/site';
const posts = await getPosts();
---
<Base title="Categories">
  <div class="container">
    <div class="page-title"><h1>~/categories</h1></div>
    <div class="cats" style="margin-top:24px">
      {Object.entries(CATEGORIES).map(([k, c]) => (
        <a class="cat" href={`/category/${k}/`}><span class="ic">{c.icon}</span><strong>{c.name}</strong><small>{posts.filter((p) => p.data.category === k).length} posts</small></a>
      ))}
    </div>
  </div>
</Base>
