---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/site';
const posts = await getPosts();
---
<Base title="Bài viết" description="Tất cả bài viết">
  <div class="container narrow">
    <div class="page-title"><h1>~/blog</h1><p>{posts.length} bài viết</p></div>
    <div class="posts" style="margin-top:24px">{posts.map((p) => <PostCard post={p} />)}</div>
  </div>
</Base>
